*.exe
*.app
*.dmg
*.msi
*.deb
*.rpm

# Ignore Unity Cloud Build artifacts
CloudBuild/

# Ignore asset store tools
AssetStoreTools/

# Ignore temporary Unity files
*.backup
*.old
*.orig
*.rej

# Ignore git-related files inside project (if any)
.git/

# Ignore .DS_Store on macOS
**/.DS_Store

# Ignore .vscode settings if you don't want to share them
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json



# Ignore Unity's auto-generated library files
Library/

